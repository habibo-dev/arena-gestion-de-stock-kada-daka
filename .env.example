# ---- AutoStock configuration -------------------------------------------------
# Copy this file to .env.local and adjust the values.

# SQLite database file (created automatically, seeded with demo data on first start)
DATABASE_PATH=./data/autostock.db

# Directory used for uploaded files (part images, temporary Excel imports)
UPLOAD_DIR=./data/uploads

# Seed demo data automatically when the database is empty (true/false)
SEED_DEMO_DATA=true

# Session cookie: secure (HTTPS only) in production. Set to "false" ONLY when the app is
# served over plain HTTP (e.g. http://192.168.1.10:3000), otherwise the login cookie is rejected.
COOKIE_SECURE=

# ---- Optional: external vision / OCR provider --------------------------------
# When left empty, AutoStock uses the built-in local OCR engine (Tesseract).
# Point these to a compatible vision API to enable remote analysis.
VISION_API_URL=
VISION_API_KEY=
